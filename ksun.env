# ============================================================
# FinELikEWinE_69 kernel build env  (mt6768: lancelot / merlin)
# xxKSU preset = same settings the FInelikewine author uses for this FinELikEWinE_69 tree.
# Every key appears exactly ONCE (the workflow uses the last value if a key is repeated).
# ============================================================

# ---- Base ----
KERNEL_SOURCE=https://github.com/suman-1007-cyber/FinELikEWinE-MT6768-KerneL_69
KERNEL_SOURCE_BRANCH=FinELikEWinE_69
KERNEL_ARCH=arm64
KERNEL_IMAGE_NAME=Image.gz-dtb

# Real defconfig + per-device fragments (paths are relative to arch/arm64/configs)
KERNEL_CONFIG_BASE=vendor/mt6768_defconfig
# Comma-separated device list; each one builds vendor/<device>.config on top of the base
DEVICES=lancelot
KERNEL_CONFIG_FRAGMENT_DIR=vendor

# ---- KernelSU (xxKSU driver, from the author's config-xxksu.env) ----
ENABLE_KERNELSU=true
KERNELSU_SETUP_SOURCE=https://raw.githubusercontent.com/suman-1007-cyber/FinELikEWinE-KerneLSU_69/FinELikEWinE_69/kernel/setup.sh
KERNELSU_TAG=FinELikEWinE_69
ADD_KPROBES_CONFIG=false
KSU_HOOKS_PATCH=false
KSU_REVERT=false
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=


# ---- APatch ----
ADD_APATCH_SUPPORT=false
FIX_APATCH_OPENELA=false

# ---- Compiler (author's toolchain: AOSP clang, no GCC) ----
USE_CLANG=true
CLANG_SOURCE=https://github.com/suman-1007-cyber/FinELikEWinE-Clang_69/releases/download/clang-r614150-aosp/clang.tar.gz
CLANG_BRANCH=
USE_GCC=false
USE_GCC_64=false
GCC_64_SOURCE=
GCC_64_BRANCH=
USE_GCC_32=false
GCC_32_SOURCE=
GCC_32_BRANCH=
# Previous Neutron clang, if you ever want it back:
# CLANG_SOURCE=https://github.com/Neutron-Toolchains/clang-build-catalogue/releases/download/30072026/neutron-clang-30072026.tar.zst

# ---- AnyKernel3 ----
USE_ANYKERNEL3=true
ANYKERNEL3_SOURCE=https://github.com/suman-1007-cyber/AnyKernel3.git
ANYKERNEL3_BRANCH=FinELikEWinE_69



# ---- Build ----
EXTRA_CMDS=LLVM=1 LLVM_IAS=1 CROSS_COMPILE=aarch64-linux-gnu- CROSS_COMPILE_ARM32=arm-linux-gnueabi- CROSS_COMPILE_COMPAT=arm-linux-gnueabi- CONFIG_NO_ERROR_ON_MISMATCH=y TARGET_BUILD_VARIANT=user
LOCALVERSION=-FinELikEWinE_69
DISABLE_LTO=
DISABLE_CC_WERROR=true
ENABLE_PYTHON2=false
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=https://raw.githubusercontent.com/xiaoleGun/KernelSU_action/main/boot/boot.img

# ---- Misc ----
ADD_OVERLAYFS_CONFIG=false

# ---- Config tweaks (applied after defconfig + device fragment, before olddefconfig) ----
# NOTE: keep comments on their own line; the loader keeps everything after '=' as the value.
# TCP BBR as the default congestion control + fq as the default qdisc
# (switch back at runtime: sysctl -w net.ipv4.tcp_congestion_control=cubic)
ENABLE_BBR_FQ=true
# Adds BFQ as a selectable I/O scheduler (built in; the default scheduler is NOT changed)
ENABLE_BFQ=true
# WireGuard, PSI and exFAT are already pulled in by ANDROID_DEFAULT_SETTING; this pins them on
ENSURE_EXTRA_FEATURES=true
# Turns off CFG80211_DEVELOPER_WARNINGS and SCHEDSTATS (NL80211_TESTMODE is kept on purpose:
# the MediaTek Wi-Fi driver uses it)
DISABLE_DEBUG_OPTIONS=true

# ---- Proton specific ----
FIX_WIFI_SPEED=true

# ---- KPM ----
KPM_SUPPORT=false
KPM_URL=https://github.com/SukiSU-Ultra/SukiSU_KernelPatch_patch/releases/download/0.12.2/patch_linux
